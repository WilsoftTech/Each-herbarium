// EACH content database (PostgreSQL on Neon). ADR 0007.
//
// Conventions:
// - Table and column names are snake_case in the database (@@map / @map).
// - Every editorial model carries the same workflow columns: status,
//   placeholder, version (optimistic locking), timestamps and actor ids.
// - Slugs, roles and the single settings row are also enforced by CHECK
//   constraints added by hand in the migration SQL, so the database rejects
//   bad data even if application validation is bypassed.
// - Media referenced by content cannot be deleted (ON DELETE RESTRICT).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // Fetch related CMS rows in SQL instead of repeated network round trips.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Authentication (Better Auth tables; field names are fixed by Better Auth)
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  /// admin | reviewer | editor. Never accepted from client input (Better Auth `input: false`).
  role          String   @default("editor")
  /// Deactivated users cannot sign in and lose existing sessions.
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sessions    Session[]
  accounts    Account[]
  auditEvents AuditEvent[]
  uploads     MediaAsset[] @relation("MediaUploadedBy")

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  /// Password hash (scrypt) for the email-and-password provider.
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

/// Shared by Better Auth (sign-in limits) and the application limiter
/// (keys prefixed "app:"), so limits hold across serverless instances.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}

// ---------------------------------------------------------------------------
// Editorial workflow
// ---------------------------------------------------------------------------

enum ContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED

  @@map("content_status")
}

enum MediaKind {
  IMAGE
  DOCUMENT

  @@map("media_kind")
}

enum MediaStatus {
  /// Row written before the object is stored; cleaned up if never completed.
  PENDING
  READY

  @@map("media_status")
}

/// Where a media file lives: the repository's public folder (licensed
/// stand-in photography from M03) or Neon Object Storage (uploads).
enum MediaStorage {
  STATIC
  R2
  NEON

  @@map("media_storage")
}

model MediaAsset {
  id           String       @id @default(cuid())
  storage      MediaStorage
  /// STATIC: path under /public, e.g. "/images/x.jpg". R2: random object key.
  key          String       @unique
  kind         MediaKind
  status       MediaStatus  @default(PENDING)
  mimeType     String       @map("mime_type")
  byteSize     Int          @map("byte_size")
  /// Original file name, shown in the library only.
  fileName     String       @map("file_name")
  /// SHA-256 of the file contents (hex), for integrity and duplicate checks.
  checksum     String?
  width        Int?
  height       Int?
  alt          String       @default("")
  caption      String       @default("")
  creditAuthor String       @map("credit_author")
  license      String
  licenseUrl   String?      @map("license_url")
  sourceUrl    String?      @map("source_url")
  uploadedById String?      @map("uploaded_by_id")
  uploadedBy   User?        @relation("MediaUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  programmeImages Programme[]      @relation("ProgrammeImage")
  projectImages   Project[]        @relation("ProjectImage")
  projectGallery  ProjectGallery[]
  articleImages   Article[]        @relation("ArticleImage")
  articleFiles    Article[]        @relation("ArticleDocument")
  resourceFiles   Resource[]       @relation("ResourceDocument")
  teamPhotos      TeamMember[]     @relation("TeamPhoto")
  pageImages      Page[]           @relation("PageHeroImage")
  partnerLogos    Partner[]        @relation("PartnerLogo")
  settingsImages  SiteSettings[]   @relation("SettingsSocialImage")

  @@index([kind, status, createdAt])
  @@index([status, createdAt])
  @@map("media_assets")
}

/// Single row (id = 1): organisation-wide details editable by administrators.
/// The organisation's name and logo are protected brand assets kept in code
/// (AGENTS.md section 4); only the wording around them is managed here.
model SiteSettings {
  id              Int         @id @default(1)
  contactEmail    String?     @map("contact_email")
  phone           String?
  postalAddress   String?     @map("postal_address")
  /// Where EACH works, in words; shown with the contact details.
  locationText    String?     @map("location_text")
  officeHours     String?     @map("office_hours")
  /// [{ label, url }]
  socialLinks     Json        @default("[]") @map("social_links")
  /// One sentence describing EACH: footer, structured data, default description.
  tagline         String      @default("Plant conservation, herbarium development and botanical knowledge for East Africa, beginning in Uganda.")
  /// Closing line of the footer.
  footerStatement String      @default("Preserving East Africa's Plant Heritage.") @map("footer_statement")
  /// Small print under the footer links.
  footerNote      String      @default("Photography is credited alongside each image. Some content is awaiting approval and is marked on the page.") @map("footer_note")
  /// Optional copyright line; empty hides it.
  copyrightText   String      @default("") @map("copyright_text")
  /// Default sharing image for pages without their own.
  socialImageId   String?     @map("social_image_id")
  socialImage     MediaAsset? @relation("SettingsSocialImage", fields: [socialImageId], references: [id], onDelete: Restrict)
  /// Label, description, order and visibility overrides for the approved
  /// navigation (src/config/navigation.ts). Destinations are not editable.
  navigation      Json        @default("{}")
  updatedById     String?     @map("updated_by_id")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@map("site_settings")
}

/// Fixed-route public pages managed in the CMS. The slug selects an entry in
/// the page registry (src/features/pages/registry.ts), which decides the route,
/// the layout and which fields apply: prose pages use `body`, the homepage
/// uses `content`, landing pages use the header fields only.
model Page {
  id          String        @id @default(cuid())
  slug        String        @unique @db.VarChar(120)
  status      ContentStatus @default(DRAFT)
  placeholder Boolean       @default(false)
  version     Int           @default(1)
  title       String
  description String
  eyebrow     String        @default("")
  lead        String        @default("")
  /// Rich text: "## " headings, "- " list items, blank-line paragraphs,
  /// [text](/path) links. Rendered by src/lib/rich-text.ts, never as HTML.
  body        String        @default("")
  heroImageId String?       @map("hero_image_id")
  heroImage   MediaAsset?   @relation("PageHeroImage", fields: [heroImageId], references: [id], onDelete: Restrict)
  /// Typed section content validated by the page registry (homepage and landing pages).
  content     Json          @default("{}")
  /// Search title, when it should differ from the page title.
  seoTitle    String?       @map("seo_title")
  noindex     Boolean       @default(false)
  publishedAt DateTime?     @map("published_at")
  createdById String?       @map("created_by_id")
  updatedById String?       @map("updated_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([status])
  @@map("pages")
}

model Programme {
  id             String             @id @default(cuid())
  slug           String             @unique @db.VarChar(120)
  status         ContentStatus      @default(DRAFT)
  placeholder    Boolean            @default(false)
  version        Int                @default(1)
  sortOrder      Int                @default(0) @map("sort_order")
  title          String
  summary        String
  intro          String
  /// Grouping label, e.g. "Conservation" or "Knowledge".
  category       String             @default("")
  objectives     String[]           @default([])
  /// Rich text (src/lib/rich-text.ts).
  body           String             @default("")
  /// Designed page sections of the founding programmes (designed-content.ts).
  content        Json               @default("{}")
  featured       Boolean            @default(false)
  seoTitle       String?            @map("seo_title")
  seoDescription String?            @map("seo_description")
  noindex        Boolean            @default(false)
  imageId        String             @map("image_id")
  image          MediaAsset         @relation("ProgrammeImage", fields: [imageId], references: [id], onDelete: Restrict)
  projects       ProjectProgramme[]
  publishedAt    DateTime?          @map("published_at")
  createdById    String?            @map("created_by_id")
  updatedById    String?            @map("updated_by_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@index([status, sortOrder])
  @@map("programmes")
}

model Project {
  id                String             @id @default(cuid())
  slug              String             @unique @db.VarChar(120)
  status            ContentStatus      @default(DRAFT)
  placeholder       Boolean            @default(false)
  version           Int                @default(1)
  sortOrder         Int                @default(0) @map("sort_order")
  title             String
  summary           String
  ecosystem         String
  location          String?
  country           String?
  period            String?
  startDate         DateTime?          @map("start_date") @db.Date
  endDate           DateTime?          @map("end_date") @db.Date
  /// Operational status, separate from the editorial `status`; null until confirmed.
  operationalStatus ProjectStatus?     @map("operational_status")
  objectives        String[]           @default([])
  activities        String[]           @default([])
  /// Only outcomes EACH can evidence.
  outcomes          String[]           @default([])
  /// Sources, one per entry; [text](https://...) links allowed.
  references        String[]           @default([])
  featured          Boolean            @default(false)
  seoTitle          String?            @map("seo_title")
  seoDescription    String?            @map("seo_description")
  noindex           Boolean            @default(false)
  imageId           String             @map("image_id")
  image             MediaAsset         @relation("ProjectImage", fields: [imageId], references: [id], onDelete: Restrict)
  /// { heading, body: string[] }
  landscape         Json
  /// [{ heading, body: string[] }]
  story             Json               @default("[]")
  programmes        ProjectProgramme[]
  partners          ProjectPartner[]
  gallery           ProjectGallery[]
  publishedAt       DateTime?          @map("published_at")
  createdById       String?            @map("created_by_id")
  updatedById       String?            @map("updated_by_id")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@index([status, sortOrder])
  @@map("projects")
}

model ProjectProgramme {
  projectId   String    @map("project_id")
  programmeId String    @map("programme_id")
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Restrict)

  @@id([projectId, programmeId])
  @@index([programmeId])
  @@map("project_programmes")
}

model ProjectPartner {
  projectId String  @map("project_id")
  partnerId String  @map("partner_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@id([projectId, partnerId])
  @@index([partnerId])
  @@map("project_partners")
}

model ProjectGallery {
  projectId String     @map("project_id")
  mediaId   String     @map("media_id")
  position  Int
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([projectId, mediaId])
  @@unique([projectId, position])
  @@index([mediaId])
  @@map("project_gallery")
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ON_HOLD

  @@map("project_status")
}

enum ArticleType {
  PUBLICATION
  GUIDE
  STORY

  @@map("article_type")
}

/// Written content read on the site: publications, guides and stories (/resources/[slug]).
model Article {
  id             String        @id @default(cuid())
  slug           String        @unique @db.VarChar(120)
  status         ContentStatus @default(DRAFT)
  placeholder    Boolean       @default(false)
  version        Int           @default(1)
  type           ArticleType
  title          String
  summary        String
  /// Publication date shown to readers (date only); null until confirmed.
  publishedOn    DateTime?     @map("published_on") @db.Date
  authors        String[]      @default([])
  /// Paragraphs.
  body           String[]      @default([])
  imageId        String?       @map("image_id")
  image          MediaAsset?   @relation("ArticleImage", fields: [imageId], references: [id], onDelete: Restrict)
  /// Optional downloadable file (for example the full publication as PDF).
  documentId     String?       @map("document_id")
  document       MediaAsset?   @relation("ArticleDocument", fields: [documentId], references: [id], onDelete: Restrict)
  /// Scientific or source references, one per entry.
  references     String[]      @default([])
  featured       Boolean       @default(false)
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description")
  noindex        Boolean       @default(false)
  publishedAt    DateTime?     @map("published_at")
  createdById    String?       @map("created_by_id")
  updatedById    String?       @map("updated_by_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([status, publishedOn])
  @@map("articles")
}

/// Standalone downloadable documents listed on /resources (toolkits, reports, data).
model Resource {
  id          String        @id @default(cuid())
  slug        String        @unique @db.VarChar(120)
  status      ContentStatus @default(DRAFT)
  placeholder Boolean       @default(false)
  version     Int           @default(1)
  title       String
  summary     String
  publishedOn DateTime?     @map("published_on") @db.Date
  documentId  String        @map("document_id")
  document    MediaAsset    @relation("ResourceDocument", fields: [documentId], references: [id], onDelete: Restrict)
  publishedAt DateTime?     @map("published_at")
  createdById String?       @map("created_by_id")
  updatedById String?       @map("updated_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([status, publishedOn])
  @@map("resources")
}

model Partner {
  id           String           @id @default(cuid())
  slug         String           @unique @db.VarChar(120)
  status       ContentStatus    @default(DRAFT)
  placeholder  Boolean          @default(false)
  version      Int              @default(1)
  sortOrder    Int              @default(0) @map("sort_order")
  name         String
  /// Partners are always independent of EACH (AGENTS.md §1).
  relationship String           @default("independent-partner")
  description  String
  /// Partner page on this site, e.g. "/bitwiire-herbarium-cafe".
  href         String?
  websiteUrl   String?          @map("website_url")
  /// For example "Research" or "Community"; shown as a label.
  category     String           @default("")
  /// The partner's approved logo, uploaded as supplied by the partner.
  logoId       String?          @map("logo_id")
  logo         MediaAsset?      @relation("PartnerLogo", fields: [logoId], references: [id], onDelete: Restrict)
  projects     ProjectPartner[]
  publishedAt  DateTime?        @map("published_at")
  createdById  String?          @map("created_by_id")
  updatedById  String?          @map("updated_by_id")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([status, sortOrder])
  @@map("partners")
}

enum TeamGroup {
  LEADERSHIP
  BOARD
  ADVISER

  @@map("team_group")
}

model TeamMember {
  id               String        @id @default(cuid())
  slug             String        @unique @db.VarChar(120)
  status           ContentStatus @default(DRAFT)
  placeholder      Boolean       @default(false)
  version          Int           @default(1)
  sortOrder        Int           @default(0) @map("sort_order")
  group            TeamGroup     @default(LEADERSHIP)
  name             String
  roleTitle        String        @map("role_title")
  /// Paragraphs.
  bio              String[]      @default([])
  photoId          String?       @map("photo_id")
  photo            MediaAsset?   @relation("TeamPhoto", fields: [photoId], references: [id], onDelete: Restrict)
  /// The person has agreed to appear on the site. Required before publication.
  consentConfirmed Boolean       @default(false) @map("consent_confirmed")
  publishedAt      DateTime?     @map("published_at")
  createdById      String?       @map("created_by_id")
  updatedById      String?       @map("updated_by_id")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@index([status, group, sortOrder])
  @@map("team_members")
}

/// Pending changes to a published item (ADR 0011). The live row stays as it
/// is until a reviewer approves the revision, which then applies `data` to it
/// in one transaction and deletes the revision. At most one per item.
model ContentRevision {
  id          String        @id @default(cuid())
  /// Collection key from src/lib/cache-tags.ts, e.g. "projects".
  collection  String        @db.VarChar(40)
  entityId    String        @map("entity_id")
  /// DRAFT or IN_REVIEW only (CHECK constraint).
  status      ContentStatus @default(DRAFT)
  version     Int           @default(1)
  /// Version of the live row when the revision was started.
  baseVersion Int           @map("base_version")
  /// The complete editor input. Validated again before it is applied.
  data        Json
  submittedAt DateTime?     @map("submitted_at")
  createdById String?       @map("created_by_id")
  updatedById String?       @map("updated_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([collection, entityId])
  @@index([status, updatedAt])
  @@map("content_revisions")
}

// ---------------------------------------------------------------------------
// Inquiries (written by the public forms in M05) and audit trail
// ---------------------------------------------------------------------------

enum InquiryStatus {
  NEW
  IN_PROGRESS
  CLOSED

  @@map("inquiry_status")
}

model Inquiry {
  id           String        @id @default(cuid())
  status       InquiryStatus @default(NEW)
  topic        String
  name         String
  email        String
  organisation String?
  message      String
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("inquiries")
}

/// Append-only record of security-relevant and editorial actions. UPDATE and
/// DELETE are blocked by a trigger (migration SQL).
model AuditEvent {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now()) @map("created_at")
  actorId    String?  @map("actor_id")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  /// Email at the time of the action, kept if the account changes later.
  actorEmail String?  @map("actor_email")
  /// e.g. "project.update", "project.approve", "media.upload", "auth.sign-in".
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  summary    String
  metadata   Json?

  @@index([createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_events")
}
