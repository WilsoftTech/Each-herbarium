# EACH environment variables
#
# Copy to .env.local for local development. Never commit real values.
# Every variable is validated in src/validation/env.ts. Add new variables there
# and here, with a comment, in the same change that first uses them.
# Server-only: none of these may be given a NEXT_PUBLIC_ prefix.

# Absolute public URL of the site, used for canonical and Open Graph URLs.
# Optional. When unset, the site URL resolves in this order:
#   1. https://$VERCEL_PROJECT_PRODUCTION_URL on Vercel production
#   2. https://$VERCEL_URL on Vercel preview deployments
#   3. http://localhost:3000
SITE_URL=

# --- Database (Neon PostgreSQL, M04) -----------------------------------------
# Locally: a Neon DEVELOPMENT branch, never production. Required by the build
# (public pages are prerendered from the database), the tests and the app.
# Pooled connection string (host contains "-pooler"), used at runtime:
DATABASE_URL=
# Direct (unpooled) connection string for the same database, used by Prisma
# migrations and command-line scripts:
DATABASE_URL_UNPOOLED=
# Optional. PostgreSQL schema to use instead of "public". Set only by the test
# suite (each_test); leave unset everywhere else.
# DATABASE_SCHEMA=

# --- Admin authentication (Neon Managed Auth, M04) ---------------------------
# At least 32 random characters: openssl rand -base64 32. One per environment.
NEON_AUTH_COOKIE_SECRET=
# Pulled by neon deploy. Keep the full path, including /auth.
NEON_AUTH_BASE_URL=
# Pulled by Neon; available for JWT verification by future backend endpoints.
NEON_AUTH_JWKS_URL=

# --- Neon Object Storage, M04 -----------------------------------------------
# Pulled by neon deploy. The assets bucket in neon.ts stays private;
# authorised uploads and public /media reads go through the application.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# --- Neon Functions and branch identity -------------------------------------
# Pulled by Neon. The historical hello slug serves the backend liveness probe.
NEON_FUNCTION_HELLO_BASE_URL=
# Local tests refuse production/main; use neon checkout dev --create first.
NEON_BRANCH=

# --- Email (Resend, M05) ----------------------------------------------------
# Optional. When any of the three is empty, enquiries are still stored and staff
# see "Email not configured" on each one in the admin. Never NEXT_PUBLIC_.
RESEND_API_KEY=
# Sender on a domain verified in Resend (SPF, DKIM and DMARC set up), e.g.
# EACH <enquiries@your-verified-domain>
EMAIL_FROM=
# Staff inbox that receives a notification for each new enquiry.
ENQUIRY_NOTIFICATION_EMAIL=
